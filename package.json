{
  "name": "visit-control",
  "version": "1.0.0",
  "description": "Sistema de Controle de Visitantes",
  "license": "MIT",
  "private": true,
  "packageManager": "pnpm@10.26.1",
  "scripts": {
    "preinstall": "node scripts/ensure-pnpm.cjs",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./apps/**\" --if-present run typecheck",
    "test": "pnpm --filter @visit-control/backend run test",
    "dev:backend": "pnpm --filter @visit-control/backend run dev",
    "dev:frontend": "pnpm --filter @visit-control/frontend run dev",
    "dev:desktop": "pnpm --filter @visit-control/desktop run dev",
    "build:desktop": "pnpm --filter @visit-control/desktop run build",
    "db:push": "pnpm --filter @visit-control/db run push",
    "db:generate": "pnpm --filter @visit-control/db run generate",
    "db:migrate": "pnpm --filter @visit-control/db run migrate"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "prettier": "^3.9.4",
    "typescript": "~5.9.3"
  }
}
