# ============================================================
# Banco de dados (PostgreSQL)
# ============================================================
DATABASE_URL=postgresql://visit_user:visit_pass@db:5432/visit_control

# ============================================================
# Segurança
# ============================================================
# Chave secreta para assinar os tokens JWT (mínimo 32 caracteres)
SESSION_SECRET=troque-por-uma-chave-secreta-longa-e-aleatoria

# ============================================================
# Servidor Backend
# ============================================================
NODE_ENV=production
PORT=3001

# Origens permitidas para CORS (separadas por vírgula)
# Exemplo: https://visitas.prefeitura.gov.br,https://www.prefeitura.gov.br
ALLOWED_ORIGINS=http://localhost:8080

# ============================================================
# Servidor Frontend (somente para ambiente de desenvolvimento)
# ============================================================
VITE_API_URL=http://localhost:3001

# ============================================================
# Logs
# ============================================================
# Nível de log: trace | debug | info | warn | error | fatal
LOG_LEVEL=info
